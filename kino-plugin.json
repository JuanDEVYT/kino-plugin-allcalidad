{
  "id": "allcalidad",
  "name": "AllCalidad",
  "version": "1.0.2",
  "apiVersion": 8,
  "entry": "plugin.js",
  "icon": "icon.png",
  "hosts": [
    "allcalidad.re",
    "vimeos.net",
    "s1.vimeos.net",
    "s2.vimeos.net",
    "voe.sx",
    "api.themoviedb.org",
    "image.tmdb.org",
    "*.vimeos.net",
    "*.vimeos.zip",
    "vimeos.zip",
    "p2.vimeos.zip",
    "p3.vimeos.zip",
    "p4.vimeos.zip",
    "p5.vimeos.zip",
    "p6.vimeos.zip",
    "*.allcalidad.re",
    "*.voe.sx",
    "voe-network.net",
    "*.voe-network.net",
    "voeun-block.com",
    "*.voeun-block.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "theme": {
    "accent": "#1863d1",
    "background": "#090f1e"
  },
  "settings": [
    {
      "key": "openScreenNotice",
      "label": "AllCalidad Pantalla",
      "type": "section",
      "hint": "AllCalidad incluye una pantalla visual nativa completa accesible desde el men\u00fa principal de Kino.",
      "labelEn": "AllCalidad Screen",
      "hintEn": "AllCalidad features a complete visual native screen accessible from Kino's main menu."
    }
  ],
  "enhancements": {
    "14": {
      "capabilities": [
        "screen"
      ],
      "screen": {
        "label": "AllCalidad",
        "labelEn": "AllCalidad",
        "icon": "movie",
        "menuOpens": "screen",
        "opensFrom": [
          "menu",
          "settings"
        ],
        "settingsButton": {
          "label": "Abrir AllCalidad",
          "labelEn": "Open AllCalidad"
        },
        "settingsIn": "screen"
      }
    },
    "19": {
      "capabilities": [
        "screen"
      ]
    }
  },
  "streamHosts": "any",
  "browser": "pages"
}